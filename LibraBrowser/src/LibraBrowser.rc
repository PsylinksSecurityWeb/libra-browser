// Libra Browser - Windows Resource Script
#include "resource.h"

IDI_LIBRA     ICON  "libra.ico"
IDI_INCOGNITO ICON  "incognito.ico"

STRINGTABLE
BEGIN
    1  "Libra Browser"
    2  "Lightweight. Private. Fast."
END

// Version information
1 VERSIONINFO
FILEVERSION    3,8,4,0
PRODUCTVERSION 3,8,4,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Psylinks Security Private Limited"
            VALUE "LegalCopyright",   "Built by Psylinks Security Private Limited"
            VALUE "FileDescription",  "Libra Browser - Lightweight Windows Browser"
            VALUE "FileVersion",      "3.8.4.0"
            VALUE "InternalName",     "LibraBrowser"
            VALUE "OriginalFilename", "LibraBrowser.exe"
            VALUE "ProductName",      "Libra Browser"
            VALUE "ProductVersion",   "3.8.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application Manifest (DPI-aware, Common Controls v6)
1 RT_MANIFEST "LibraBrowser.manifest"
